{
  "manifest_version": 3,
  "name": "Work Justification Activity Timer",
  "version": "1.0.0",
  "description": "Counts active time in selected work apps and syncs daily totals to the Work Justification Activity Log.",
  "key": "",
  "permissions": ["alarms", "idle", "storage", "tabs"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://docs.google.com/spreadsheets/*",
    "https://training-hub-rust.vercel.app/tl*",
    "https://zoho.com/*",
    "https://*.zoho.com/*",
    "https://zoho.in/*",
    "https://*.zoho.in/*",
    "https://zoho.eu/*",
    "https://*.zoho.eu/*",
    "https://web.whatsapp.com/*",
    "https://work-justification.vercel.app/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Work activity" }
}

